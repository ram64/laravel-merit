parameters:
    level: 5
    paths:
        - src
        - config
        - database
        # tests/ is analysed so the traits get analysed at all: PHPStan skips a
        # trait no analysed class uses, which meant CanAchieve and CanExperience
        # were never looked at.
        - tests
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    # There is deliberately no baseline. Everything below is a false positive
    # with a stated reason, so a new error fails the run rather than being
    # appended to a file nobody reads.
    ignoreErrors:
        # config/merit.php is the package's publishable config template. env()
        # is exactly what belongs in a config file; larastan's rule fires only
        # because it cannot tell this is a config directory without an app.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/merit.php

        # A verbatim copy of the config 0.2 published, kept to test that an
        # application still holding it gets the newer defaults merged in.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: tests/Fixtures/Config/merit-0.2.php

        # GeneratorCommand documents handle() as returning bool|null, but
        # Command::execute() casts whatever handle() returns to the exit code.
        # Returning true for success made a successful run exit 1.
        -
            identifier: method.childReturnType
            path: src/Commands/MakeAchievementCommand.php

        # Pest's arch DSL is not statically typed.
        -
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::expect\(\)\.$#'
            path: tests/ArchTest.php
